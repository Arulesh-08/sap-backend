MONGO_URI=mongodb://127.0.0.1:27017/sap_points
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
PORT=5001
# Your deployed Vercel frontend URL (used to lock down CORS)
ALLOWED_ORIGIN=https://sap-frontend-lake.vercel.app
# Admin email — owner of the admin account (must match the registered email)
AUTHORIZED_ADMIN_EMAIL=admin@example.com
